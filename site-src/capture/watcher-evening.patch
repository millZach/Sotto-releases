+++ 2/check-site-capture.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd ~/sotto-site-capture-out
+mkdir -p /tmp/sotto-site-frames
+for n in room watched needs-you merge; do
+  ffprobe -v error -show_entries format=duration,size:stream=codec_type,codec_name,width,height,r_frame_rate,nb_frames,pix_fmt -of compact $n.mp4
+  for t in 0 2.5 5 7.5 9.9; do ffmpeg -v error -y -ss $t -i $n.mp4 -frames:v 1 /tmp/sotto-site-frames/$n-$t.png; done
+  # motion: mean abs diff between frames 1s apart, in the scene margins
+  ffmpeg -v error -i $n.mp4 -vf "crop=380:700:0:60,tblend=all_mode=difference,signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=-" -f null - 2>/dev/null | grep YAVG | awk -F= '{s+=$2; if ($2>0.05) m++; c++} END {printf "margin motion: mean %.3f, frames moving %d of %d\n", s/c, m, c}'
+done
