+#!/usr/bin/env bash
+# Usage: run.sh <stills|record> [build] [only]
+set -euo pipefail
+cd ~/sotto-site-capture
+if [ "${2:-}" = build ]; then npm run build > /tmp/sotto-site-build.log 2>&1; fi
+export SITE_PART="$1" SITE_OUT="$HOME/sotto-site-capture-out" SITE_SCALE="${SITE_SCALE:-200}"
+[ -n "${3:-}" ] && export SITE_ONLY="$3"
+xvfb-run -a -s "-screen 0 3200x2200x24" npx playwright test tests/e2e/site-capture.spec.ts --reporter=line
